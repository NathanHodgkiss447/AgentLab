{
  "name": "agentlab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.17.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "https://registry.npmjs.org/@radix-ui/react-slot/-/react-slot-1.3.3.tgz",
    "@radix-ui/react-switch": "https://registry.npmjs.org/@radix-ui/react-switch/-/react-switch-1.3.7.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "https://registry.npmjs.org/zod/-/zod-4.4.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "2.1.9"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:live && npm run lint && npm test && npm run demo:audio:check",
    "typecheck": "tsc --noEmit",
    "typecheck:live": "tsc --noEmit -p tsconfig.live.json",
    "setup:live": "npm install @elevenlabs/react@1.17.0 && npm run typecheck:live",
    "demo:audio:generate": "node scripts/generate-demo-audio.mjs",
    "demo:audio:check": "node scripts/generate-demo-audio.mjs --check",
    "demo:audio:plan": "node scripts/generate-demo-audio.mjs --plan",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
